# ==============================================================================
# ActionOS Pay: Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# MODE A: LOCAL DEMO MODE (Zero Credentials Required)
# For local evaluation, UI walkthrough, and automated test execution.
# The application runs with an in-memory ledger and deterministic AI planner.
# ------------------------------------------------------------------------------
APP_MODE=demo
PAYPAL_ALLOW_SIMULATION=true
APPROVAL_SIGNING_SECRET=c0ffee-demo-signing-secret-at-least-32-characters-long

# ------------------------------------------------------------------------------
# MODE B: REAL PAYPAL ORDERS V2 SANDBOX INTEGRATION
# Required for live PayPal Sandbox checkout, live order creation, and webhooks.
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
# ------------------------------------------------------------------------------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# ------------------------------------------------------------------------------
# MODE C: AUTHORITATIVE POSTGRESQL / SUPABASE LEDGER (Optional for Demo)
# Required for multi-tenant Row Level Security (RLS) and database RPCs.
# Sequential migrations: supabase/migrations/00001 -> 00009
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# AI INTENT PLANNER (Gemini API)
# Optional: If omitted, uses deterministic catalogue matching engine.
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-1.5-flash
